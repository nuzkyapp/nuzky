{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The editor's own page. A webview added to its window later gets none of this.",
  "webviews": ["main"],
  "permissions": [
    "main-ui",
    "core:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-set-title",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-ask",
    "opener:allow-reveal-item-in-dir"
  ]
}
