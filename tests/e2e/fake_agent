if CODEX and args == ['login', 'status']:
    print('Not logged in' if signed_out else 'Logged in using ChatGPT', file=sys.stderr if signed_out else sys.stdout)
    sys.exit(1 if signed_out else 0)
if args[:3] == ['mcp', 'get', 'nuzky']:
    home = Path(os.environ['HOME'])
    path = Path(os.environ.get('CODEX_HOME', home / '.codex')) / 'config.toml' if CODEX else \
        Path(os.environ.get('CLAUDE_CONFIG_DIR', home)) / '.claude.json'
    config = (tomllib.loads(path.read_text()) if CODEX else json.loads(path.read_text())) if path.exists() else {}
    server = config.get('mcp_servers' if CODEX else 'mcpServers', {}).get('nuzky')
    if server is None:
        print('No MCP server named "nuzky" found.', file=sys.stderr)
        sys.exit(1)
    if CODEX:
        transport = dict(type='stdio', command=server['command'], args=server.get('args', []),
                         env=server.get('env'), env_vars=server.get('env_vars', []), cwd=server.get('cwd')) \
            if 'command' in server else dict(type='streamable_http', url=server.get('url'))
        print(json.dumps(dict(name='nuzky', enabled=server.get('enabled', True), disabled_reason=None, transport=transport)))
        sys.exit(0)
    connected, issue, process = False, '', None
    with tempfile.TemporaryDirectory(prefix='fake-agent-mcp-') as runtime, tempfile.TemporaryFile(mode='w+') as errors:
        env = dict(os.environ, **server.get('env', {}))
        if os.environ.get('FAKE_AGENT_MCP') == 'broken':
            env.update(TMPDIR=runtime, XDG_RUNTIME_DIR=runtime)
        try:
            process = subprocess.Popen([server['command'], *server.get('args', [])], env=env,
                                       stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=errors, text=True)
            lines = queue.Queue()
            threading.Thread(target=lambda: [lines.put(line) for line in process.stdout], daemon=True).start()
            deadline = time.monotonic() + 5
            requests = [dict(jsonrpc='2.0', id=1, method='initialize', params={
                'protocolVersion': '2025-03-26', 'capabilities': {}, 'clientInfo': {'name': 'fake-agent', 'version': '1'}}),
                dict(jsonrpc='2.0', method='notifications/initialized'),
                dict(jsonrpc='2.0', id=2, method='tools/list', params={})]
            for request in requests:
                process.stdin.write(json.dumps(request) + '\n')
                process.stdin.flush()
                if 'id' in request:
                    while True:
                        response = json.loads(lines.get(timeout=max(0, deadline - time.monotonic())))
                        if response.get('id') == request['id']:
                            if 'error' in response or 'result' not in response:
                                raise RuntimeError(str(response))
                            break
            connected = True
        except (OSError, ValueError, queue.Empty, RuntimeError) as error:
            issue = str(error)
        finally:
            if process:
                process.kill()
                process.wait()
            errors.seek(0)
            issue = errors.read().strip().split('\n')[-1] or issue
    print('nuzky:\n  Scope: User config (available in all your projects)')
    print('  Status: ✔ Connected' if connected else '  Status: ✗ Failed to connect')
    print(f"  Command: {server['command']}\n  Args: {' '.join(server.get('args', []))}")
    if not connected and issue:
        print(f'  Issue: {issue}')
    sys.exit(0)

LOG = Path(os.environ.get('NUZKY_FAKE_AGENT_LOG', '/tmp/fake-agent'))
LOG.mkdir(parents=True, exist_ok=True)


def opt(name):
    return args[args.index(name) + 1] if name in args else None


def emit(obj):
    print(json.dumps(obj, ensure_ascii=False), flush=True)


# The flags that keep the agent to Nuzky's tools; without any of them this is a bug in Nuzky.
REQUIRED = {'-p': None, '--input-format': 'stream-json', '--output-format': 'stream-json', '--tools': '', '--strict-mcp-config': None,
            '--permission-mode': 'dontAsk', '--allowedTools': 'mcp__nuzky', '--setting-sources': 'user',
            '--disable-slash-commands': None}
if CODEX:
    settings = dict(a.split('=', 1) for i, a in enumerate(args) if i and args[i - 1] == '-c')
    required = {'default_permissions': '"nuzky"', 'permissions.nuzky.filesystem': '{":minimal"="read"}', 'approval_policy': '"never"', 'features.shell_tool': 'false',
                'features.code_mode.direct_only_tool_namespaces': '["mcp__nuzky"]', 'features.image_generation': 'true',
                'mcp_servers.nuzky.default_tools_approval_mode': '"approve"'}
    missing = [f for f in ('--json', '--ignore-user-config') if f not in args]
    missing += [f'-c {k}={v}' for k, v in required.items() if settings.get(k) != v]
    if args[:1] != ['exec'] or args[-1:] != ['-']:
        missing.append('exec ... -')
    resume = args[:2] == ['exec', 'resume']
    session = args[-2] if resume else str(uuid.uuid4())
else:
    missing = [f for f, v in REQUIRED.items() if f not in args or (v is not None and opt(f) != v)]
    settings = json.loads(opt('--settings') or '{}')
    if not settings.get('disableAllHooks'):
        missing.append('--settings disableAllHooks')
    session = opt('--session-id') or opt('--resume')
    resume = '--resume' in args


def jpeg_size(data):
    """Width and height from the frame header of a JPEG, which is all Nuzky may send as a picture."""
    if data[:2] != b'\xff\xd8':
        raise ValueError('not a JPEG')
    i = 2
    while data[i] == 0xFF:
        if data[i + 1] in (0xC0, 0xC1, 0xC2):
            height, width = struct.unpack('>HH', data[i + 5:i + 9])
            return [width, height]
        i += 2 + struct.unpack('>H', data[i + 2:i + 4])[0]
    raise ValueError('no frame header')


def unpack(content):
    """Claude's user message: its text, and the size of each picture beside it."""
    if isinstance(content, str):
        return content, []
    text = '\n'.join(b['text'] for b in content if b['type'] == 'text')
    images = [b['source'] for b in content if b['type'] == 'image']
    if any((source['type'], source['media_type']) != ('base64', 'image/jpeg') for source in images):
        raise ValueError(f'a picture Claude would refuse: {images}')
    return text, [jpeg_size(base64.b64decode(source['data'])) for source in images]


messages = None
if CODEX:
    prompt = sys.stdin.read()
    pictures = [jpeg_size(Path(a.removeprefix('--image=')).read_bytes()) for a in args if a.startswith('--image=')]
else:
    prompt, pictures = unpack(json.loads(sys.stdin.readline())['message']['content'])
    messages = queue.Queue()

    def read_messages():
        for line in sys.stdin:
            text, steered = unpack(json.loads(line)['message']['content'])
            with open(LOG / 'steered.jsonl', 'a') as f:
                f.write(json.dumps({'pid': os.getpid(), 'prompt': text, 'pictures': steered}, ensure_ascii=False) + '\n')
            messages.put(text)
        messages.put(None)

    threading.Thread(target=read_messages, daemon=True).start()
with open(LOG / 'runs.jsonl', 'a') as f:
    f.write(json.dumps({'pid': os.getpid(), 'argv': args, 'cwd': os.getcwd(), 'missing': missing, 'prompt': prompt,
                        'pictures': pictures, 'resume': resume, 'session': session}, ensure_ascii=False) + '\n')
if missing:
    print(f'fake agent: Nuzky left out {missing}', file=sys.stderr)
    sys.exit(2)
sessions = LOG / 'sessions'
sessions.mkdir(exist_ok=True)
if resume and not (sessions / session).exists():
    print(f'Error: thread/resume: thread/resume failed: no rollout found for thread id {session} (code -32600)'
          if CODEX else f'No conversation found with session ID: {session}', file=sys.stderr)
    sys.exit(1)
(sessions / session).write_text(prompt)


class Mcp:
    def __init__(self, server):
        env = dict(os.environ, **server.get('env', {}))
        self.p = subprocess.Popen([server['command'], *server['args']], env=env, stdin=subprocess.PIPE,
                                  stdout=subprocess.PIPE, stderr=open(LOG / 'bridge.log', 'a'), text=True)
        self.lines, self.id = queue.Queue(), 0
        threading.Thread(target=lambda: [self.lines.put(l) for l in self.p.stdout], daemon=True).start()
        self.rpc('initialize', {'protocolVersion': '2025-03-26', 'capabilities': {}, 'clientInfo': {'name': 'fake-agent', 'version': '1'}})
        self.send({'jsonrpc': '2.0', 'method': 'notifications/initialized'})

    def send(self, m):
        self.p.stdin.write(json.dumps(m) + '\n')
        self.p.stdin.flush()

    def rpc(self, method, params):
        self.id += 1
        self.send({'jsonrpc': '2.0', 'id': self.id, 'method': method, 'params': params})
        while True:
            m = json.loads(self.lines.get(timeout=30))
            if m.get('id') == self.id:
                return m


if CODEX:
    server = {k.removeprefix('mcp_servers.nuzky.'): tomllib.loads('v = ' + v)['v']
              for k, v in settings.items() if k in ('mcp_servers.nuzky.command', 'mcp_servers.nuzky.args')}
    server['env'] = {k.removeprefix('mcp_servers.nuzky.env.'): tomllib.loads('v = ' + v)['v']
                     for k, v in settings.items() if k.startswith('mcp_servers.nuzky.env.')}
    mcp = Mcp(server)
else:
    mcp = Mcp(json.loads(opt('--mcp-config'))['mcpServers']['nuzky'])
tools = [f"mcp__nuzky__{t['name']}" for t in mcp.rpc('tools/list', {})['result']['tools']]
style = settings.get('outputStyle', 'Proactive')
if CODEX:
    emit({'type': 'thread.started', 'thread_id': session})
    emit({'type': 'turn.started'})
else:
    emit({'type': 'system', 'subtype': 'init', 'session_id': session, 'tools': tools, 'output_style': style,
          'mcp_servers': [{'name': 'nuzky', 'status': 'connected'}], 'claude_code_version': '2.1.292'})
calls = 0
items = 0


def item_id():
    global items
    tid = f'item_{items}'
    items += 1
    return tid


def say(text):
    if CODEX:
        emit({'type': 'item.completed', 'item': {'id': item_id(), 'type': 'agent_message', 'text': text}})
        return
    emit({'type': 'stream_event', 'parent_tool_use_id': None, 'event': {'type': 'message_start'}})
    for i in range(0, len(text), 12):
        emit({'type': 'stream_event', 'parent_tool_use_id': None,
              'event': {'type': 'content_block_delta', 'delta': {'type': 'text_delta', 'text': text[i:i + 12]}}})
        time.sleep(0.02)
    emit({'type': 'assistant', 'parent_tool_use_id': None, 'message': {'content': [{'type': 'text', 'text': text}]}})


def call(tool, arguments):
    if CODEX:
        item = {'id': item_id(), 'type': 'mcp_tool_call', 'server': 'nuzky', 'tool': tool,
                'arguments': arguments, 'result': None, 'error': None, 'status': 'in_progress'}
        emit({'type': 'item.started', 'item': item})
        result = mcp.rpc('tools/call', {'name': tool, 'arguments': arguments})['result']
        item.update(result={'content': result.get('content', []), 'structured_content': result.get('structuredContent')},
                    status='failed' if result.get('isError') else 'completed')
        emit({'type': 'item.completed', 'item': item})
        if result.get('isError'):
            raise RuntimeError(result['content'][0]['text'])
        return result.get('structuredContent', {})
    global calls
    calls += 1
    # Claude's ids are unique across turns; a question in a later turn is a new one.
    tid, name = f'toolu_{os.getpid()}_{calls}', f'mcp__nuzky__{tool}'
    emit({'type': 'stream_event', 'parent_tool_use_id': None, 'event': {'type': 'message_start'}})
    emit({'type': 'stream_event', 'parent_tool_use_id': None,
          'event': {'type': 'content_block_start', 'content_block': {'type': 'tool_use', 'id': tid, 'name': name, 'input': {}}}})
    emit({'type': 'assistant', 'parent_tool_use_id': None, 'message': {'content': [{'type': 'tool_use', 'id': tid, 'name': name, 'input': arguments}]}})
    result = mcp.rpc('tools/call', {'name': tool, 'arguments': arguments})['result']
    emit({'type': 'user', 'parent_tool_use_id': None,
          'message': {'content': [{'type': 'tool_result', 'tool_use_id': tid, 'is_error': bool(result.get('isError'))}]}})
    if result.get('isError'):
        raise RuntimeError(result['content'][0]['text'])
    return result.get('structuredContent', {})


def finish(error=False, text=''):
    if CODEX:
        emit({'type': 'turn.completed', 'usage': {'input_tokens': 1, 'cached_input_tokens': 0,
              'cache_write_input_tokens': 0, 'output_tokens': 1, 'reasoning_output_tokens': 0}})
    else:
        emit({'type': 'result', 'subtype': 'error_during_execution' if error else 'success', 'is_error': error, 'result': text})
        while (text := messages.get()) is not None:
            text = text.split('\n\n[Nuzky]')[0].strip().lower()
            say(f'Rozumím: {text}')
            emit({'type': 'result', 'subtype': 'success', 'is_error': False, 'result': ''})
    mcp.p.stdin.close()
    sys.exit(0)


def interrupted(*_):
    if CODEX:
        mcp.p.stdin.close()
        sys.exit(0)
    emit({'type': 'user', 'parent_tool_use_id': None, 'message': {'content': [{'type': 'text', 'text': '[Request interrupted by user]'}]}})
    finish(error=True, text='')


signal.signal(signal.SIGINT, interrupted)
message = prompt.split('\n\n[Nuzky]')[0].strip().lower()
# The thumbnail prompt carries Nuzky's guide, whose words would pick the other answers.
thumbnail = message.startswith('make a 9:16 cover')
if CODEX and message.startswith('think first'):
    # Thinking before its first item: until then Codex keeps nothing of the turn.
    time.sleep(2)

if 'signin' in message and not thumbnail:
    if CODEX:
        error = 'unexpected status 401 Unauthorized: Missing bearer or basic authentication in header, url: https://api.openai.com/v1/responses'
        for n in range(1, 6):
            emit({'type': 'error', 'message': f'Reconnecting... {n}/5 ({error})'})
            time.sleep(1)
        emit({'type': 'turn.failed', 'error': {'message': error}})
        sys.exit(1)
    emit({'type': 'assistant', 'error': 'authentication_failed', 'parent_tool_use_id': None,
          'message': {'content': [{'type': 'text', 'text': 'Not logged in · Please run /login'}]}})
    emit({'type': 'result', 'subtype': 'success', 'is_error': True, 'result': 'Not logged in · Please run /login'})
    sys.exit(1)
if 'limit' in message and not thumbnail:
    if CODEX:
        emit({'type': 'turn.failed', 'error': {'message': 'You’ve hit your usage limit. Visit https://chatgpt.com/settings/usage to purchase more credits or try again at 9:00 PM.'}})
        sys.exit(1)
    emit({'type': 'assistant', 'error': 'rate_limit', 'parent_tool_use_id': None,
          'message': {'content': [{'type': 'text', 'text': "You've hit your limit · resets 9pm"}]}})
    emit({'type': 'result', 'subtype': 'success', 'is_error': True, 'result': "You've hit your limit · resets 9pm"})
    sys.exit(1)

VIDEO = '[Nuzky] The user attached the video'
if pictures or VIDEO in prompt:
    sizes = ', '.join(f'{w}×{h}' for w, h in pictures)
    say(f'I see {len(pictures)} pictures ({sizes}) and {prompt.count(VIDEO)} videos.')
elif '[Nuzky] The user writes from the Your style page' in prompt:
    style = call('get_style', {})
    said = prompt.split('\n\n[Nuzky]')[0].strip()
    if said.lower().startswith('keep:'):
        rule = said[5:].strip()
        call('change_style', {'action': {'type': 'setOwn', 'text': rule}})
        say(f'Hotovo, máš nové pravidlo: {rule}')
    else:
        say(f"Tvůj styl má {len(style['rules'])} naučených a {len(style['own'])} tvých pravidel.")
elif thumbnail:
    wishes = prompt.split("The user's wishes, which win over the steps: ", 1)[1].split('\n', 1)[0].strip()
    hook = wishes.split(':', 1)[1].strip() if wishes.lower().startswith('hook:') else 'MY HOOK'
    state = call('get_state', {})
    at = min(7_500_000, state['duration_us'] - 100_000)
    # A frame the user chose stays, as Nuzky asks.
    if "[Nuzky] The project's cover_9x16 already uses the frame at" in prompt:
        at = int(prompt.split("[Nuzky] The project's cover_9x16 already uses the frame at", 1)[1].split('(', 1)[1].split(' ', 1)[0])
    look = {'fontFamily': 'Anton', 'fontSize': 260, 'color': '#ffffff', 'bold': False, 'strokeWidth': 0,
            'strokeColor': '#000000', 'background': None}
    text = {'text': hook, 'style': look, 'transform': {'x': 0, 'y': -0.3, 'scale': 1, 'rotation': 0, 'opacity': 1}, 'behind': True}
    wide = dict(text, style=dict(look, fontSize=170), transform=dict(text['transform'], x=0.2, y=-0.1))
    say('Udělám cover a náhledovku pro YouTube.')
    run = call('begin_run', {'label': 'Make a thumbnail'})['run_id']
    call('apply_edits', {'run_id': run, 'request_id': 'covers', 'edits': [
        {'type': 'setThumbnail', 'thumbnail': {'format': 'cover_9x16', 'timeUs': at, 'texts': [text]}},
        {'type': 'setThumbnail', 'thumbnail': {'format': 'youtube_16x9', 'timeUs': at, 'texts': [wide],
                                               'background': {'picture': True, 'blur': 1, 'dim': 0.2, 'color': '#000000'}}}]})
    for _ in range(3):
        try:
            call('inspect_thumbnail', {'format': 'cover_9x16', 'safe_zones': True})
            break
        except RuntimeError as error:
            job = str(error).split('job ', 1)[1].split(';', 1)[0] if 'MASK_NOT_READY' in str(error) else None
            if not job:
                raise
