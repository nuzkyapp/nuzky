    def ends(i):
        return words[i]['text'].rstrip().endswith(('.', '!', '?', '…')) or i + 1 == len(words) \
            or words[i + 1]['start_us'] - words[i]['end_us'] >= 600_000

    # Four moments of at least 15 s, each from a sentence's start to a sentence's end, a sentence apart.
    found, start, i = [], 0, 0
    while i < len(words) and len(found) < 4:
        if ends(i) and words[i]['end_us'] - words[start]['start_us'] >= 15_000_000:
            found.append({'from': start, 'to': i, 'title': f'Moment {len(found) + 1}', 'score': round(0.9 - 0.1 * len(found), 2),
                          'why': 'Opens with a clear line and ends on its point.'})
            i += 1
            while i < len(words) and not ends(i):
                i += 1
            start = i + 1
        i += 1
