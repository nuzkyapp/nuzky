BASE_URL=https://account.nuzky.app
# At least 32 random characters: openssl rand -hex 32. Changing it signs everyone out of the browser and the app.
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MAIL_TRANSPORT=smtp
# smtps://user:password@smtp.example.com:465
SMTP_URL=
MAIL_FROM=Nuzky <account@nuzky.app>
ACME_EMAIL=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
LITESTREAM_BUCKET=nuzky-account-backup
# https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
LITESTREAM_ENDPOINT=
LITESTREAM_REGION=
