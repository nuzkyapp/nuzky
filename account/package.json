  "scripts": {
    "dev": "ACCOUNT_MODE=test next dev --port 3100",
    "build": "next build && node -e \"require('fs').cpSync('.next/static', '.next/standalone/.next/static', { recursive: true })\"",
    "start": "node .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
