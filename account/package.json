    "next": "16.4.6",
    "nodemailer": "10.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
