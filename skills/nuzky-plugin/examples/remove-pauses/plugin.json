{
  "nuzkyPlugin": 2,
  "id": "remove-pauses",
  "name": "Remove pauses",
  "description": "Cuts out the quiet stretches of the main track longer than a length you choose, keeping a short breath on each side.",
  "version": "1.0.0",
  "action": "Remove pauses",
  "needs": ["silences"],
  "inputs": [
    { "type": "number", "id": "minSeconds", "label": "Longer than", "min": 0.2, "max": 5, "step": 0.1, "default": 0.6, "unit": "s" },
    { "type": "number", "id": "keepSeconds", "label": "Keep on each side", "min": 0, "max": 0.5, "step": 0.05, "default": 0.1, "unit": "s" }
  ]
}
